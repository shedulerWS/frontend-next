# Base URL of the Laravel backend API.
# In local dev the backend (nginx + php-fpm) is published by the backend
# docker-compose on http://localhost:8899 — see ../backend/docker-compose.dev.yml.
# Copy this file to .env.local (recommended) or .env and adjust if needed.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8899

# Telegram login widget — bot username (without the leading @).
# Optional. Leave empty if Telegram login is not used locally.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Telegram login widget — numeric bot id.
# Optional. Leave empty if Telegram login is not used locally.
NEXT_PUBLIC_TELEGRAM_BOT_ID=

# Yandex.Metrika counter id.
# Optional. Leave empty to disable analytics locally.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
